# Linux launcher template (Handlebars), used for the .deb and .rpm packages
# via `bundle.linux.*.desktopTemplate` in tauri.conf.json.
#
# Why a custom template: Tauri's default Exec line has no file
# placeholder, so file managers can't pass the clicked PDF to the app.
#   %F       → the selected file paths are appended as arguments
#   MimeType → registers the app as a PDF handler ("Open with…" / default app)
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=application/pdf;
